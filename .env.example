# Neon connection string (use a dev branch locally)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Random string; salts the IP hashes used for rate limiting
IP_SALT=change-me
# Bearer token for /admin moderation
ADMIN_TOKEN=change-me-too
# Optional: email contact-form messages to yourself via Resend
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=
